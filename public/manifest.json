{
  "manifest_version": 3,
  "name": "My Sidebar",
  "version": "1.0.0",
  "description": "Renders external websites in Chrome's side panel with a dark-themed interface",
  "icons": {
    "16": "icon16.svg",
    "48": "icon48.svg",
    "128": "icon128.svg"
  },
  "action": {
    "default_title": "Open My Sidebar",
    "default_icon": {
      "16": "icon16.svg",
      "48": "icon48.svg",
      "128": "icon128.svg"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "cookies",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "audioCapture"
  ],
  "host_permissions": [
    "https://blank.page/*",
    "https://*.blank.page/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
