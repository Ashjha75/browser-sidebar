# Environment Variables
# Copy this file to .env and fill in your actual values

# Google OAuth Client ID
# Get this from: https://console.cloud.google.com/apis/credentials
# Format: xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE.apps.googleusercontent.com

# Optional: Extension Name (defaults to "My Sidebar")
VITE_EXTENSION_NAME=My Sidebar

# Optional: Extension Version (defaults to value in package.json)
VITE_EXTENSION_VERSION=1.0.0
